msgid "EDHM compatibility"
msgstr "Compatibilité EDHM"

msgid "(Experimental) Use tailored 2DMigoto dll for EDHM compatibility improvements."
msgstr "(Expérimental) Utiliser la DLL 2DMigoto adaptée pour améliorer la compatibilité EDHM."

msgid "Backs up your standard d3d11_edhm.dll and d3dx.ini settings, installs the signed 2DMigoto build, and applies ED-UP compatibility settings. Turning off restores them."
msgstr "Sauvegarde votre d3d11_edhm.dll standard et les réglages de d3dx.ini, installe la version signée 2DMigoto et applique les réglages de compatibilité ED-UP. Désactiver les restaure."

msgid "Hide Refresh/Reload messages from EDHM"
msgstr "Masquer les messages d'actualisation/rechargement d'EDHM"

msgid "Sets [Logging] show_reload_message = 0 in d3dx.ini while 2DMigoto is active; unchecking or turning 2DMigoto off restores your original setting."
msgstr "Définit [Logging] show_reload_message = 0 dans d3dx.ini tant que 2DMigoto est actif ; décocher ou désactiver 2DMigoto restaure le réglage d'origine."

msgid "Hide Warnings from EDHM"
msgstr "Masquer les avertissements d'EDHM"

msgid "Sets [Logging] show_warnings = 0 in d3dx.ini while 2DMigoto is active; unchecking or turning 2DMigoto off restores your original setting."
msgstr "Définit [Logging] show_warnings = 0 dans d3dx.ini tant que 2DMigoto est actif ; décocher ou désactiver 2DMigoto restaure le réglage d'origine."

msgid "Requires 2DMigoto"
msgstr "Nécessite 2DMigoto"

