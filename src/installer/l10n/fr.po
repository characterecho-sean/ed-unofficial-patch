#, c-format
msgid "Connected via %s and ready for VR launch."
msgstr "Connecté via %s et prêt pour le lancement en RV."

#, c-format
msgid "%s is running, but no active headset responded. Wake or connect your headset, then refresh."
msgstr "%s est actif, mais aucun casque n'a répondu. Réveille ou connecte ton casque puis actualise."

#, c-format
msgid "Detected over USB. Start %s to connect before launching Elite in VR."
msgstr "Détecté en USB. Lance %s pour connecter le casque avant de démarrer Elite en RV."

#, c-format
msgid "%s is running while %s is set as your active OpenXR runtime. Switch OpenXR or start %s."
msgstr "%s est en cours alors que %s est ton moteur OpenXR actif. Change d'OpenXR ou lance %s."

#, c-format
msgid "%s is your active OpenXR runtime, but is not running yet. Start it or connect your headset."
msgstr "%s est ton moteur OpenXR actif, mais il n'est pas encore lancé. Démarre-le ou connecte ton casque."

msgid "Active OpenXR runtime file is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it."
msgstr "Le fichier du moteur OpenXR actif est introuvable. Ouvre SteamVR, Meta Horizon Link, Virtual Desktop ou Pimax Play pour le restaurer."

msgid "No active OpenXR runtime is registered. Start SteamVR, Meta Horizon Link, Virtual Desktop, Pimax Play, or WiVRn to enable VR."
msgstr "Aucun moteur OpenXR actif n'est enregistré. Lance SteamVR, Meta Horizon Link, Virtual Desktop, Pimax Play ou WiVRn pour activer la RV."

#, c-format
msgid "%s was found on Linux, but no Windows OpenXR runtime is registered in this Wine/Proton prefix."
msgstr "%s a été détecté sous Linux, mais aucun moteur OpenXR Windows n'est enregistré dans ce préfixe Wine/Proton."

#, c-format
msgid "The active OpenXR runtime could not be queried. Restart %s and refresh."
msgstr "Impossible d'interroger le moteur OpenXR actif. Redémarre %s puis actualise."

msgid "Detected over USB, but no active OpenXR runtime is registered yet."
msgstr "Détecté en USB, mais aucun moteur OpenXR actif n'est encore enregistré."

msgid "OpenComposite is installed as Elite's openvr_api.dll, so ED-UP's VR bridge is not active."
msgstr "OpenComposite est installé en tant qu'openvr_api.dll d'Elite ; le pont RV d'ED-UP n'est donc pas actif."

msgid "edup_openxr.ini could not be read by ED-UP. Repair ED-UP or fix the file, then refresh."
msgstr "ED-UP n'a pas pu lire edup_openxr.ini. Répare ED-UP ou corrige le fichier puis actualise."

msgid "Active OpenXR runtime library is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it."
msgstr "La bibliothèque du moteur OpenXR actif est introuvable. Ouvre SteamVR, Meta Horizon Link, Virtual Desktop ou Pimax Play pour la restaurer."

msgid "No active OpenXR runtime was found. Elite may fail to start in VR.\n\nLaunch in VR anyway?"
msgstr "Aucun moteur OpenXR actif n'a été trouvé. Elite risque de ne pas démarrer en RV.\n\nLancer en RV quand même ?"

msgid "Your active OpenXR runtime file is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it.\n\nLaunch in VR anyway?"
msgstr "Le fichier de ton moteur OpenXR actif est introuvable. Ouvre SteamVR, Meta Horizon Link, Virtual Desktop ou Pimax Play pour le restaurer.\n\nLancer en RV quand même ?"

msgid "Your active OpenXR runtime library is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it.\n\nLaunch in VR anyway?"
msgstr "La bibliothèque de ton moteur OpenXR actif est introuvable. Ouvre SteamVR, Meta Horizon Link, Virtual Desktop ou Pimax Play pour la restaurer.\n\nLancer en RV quand même ?"

msgid "edup_openxr.ini could not be read by ED-UP, so Elite will not start in VR. Repair ED-UP or fix the file.\n\nLaunch in VR anyway?"
msgstr "ED-UP n'a pas pu lire edup_openxr.ini ; Elite ne démarrera donc pas en RV. Répare ED-UP ou corrige le fichier.\n\nLancer en RV quand même ?"

#, c-format
msgid "%s did not respond in time. Live checks are paused until you restart the launcher."
msgstr "%s n'a pas répondu à temps. Les vérifications en direct sont en pause jusqu'au redémarrage du launcher."

msgid "Theme: follow Windows (switch to light)"
msgstr "Thème : suivre Windows (passer au clair)"

msgid "Theme: light (switch to dark)"
msgstr "Thème : clair (passer au sombre)"

