msgid "Inspecting the active OpenXR runtime, running VR services, and connected hardware."
msgstr "Inspeccionando el entorno OpenXR activo, los servicios de RV y el hardware conectado."

msgid "No headset detected"
msgstr "No se detectó ningún visor"

msgid "No VR runtime found"
msgstr "No se encontró entorno de RV"

msgid "Waiting for headset"
msgstr "Esperando al visor"

msgid "VR headset detected"
msgstr "Visor de RV detectado"

msgid "Connected and ready for VR launch."
msgstr "Conectado y listo para iniciar en RV."

#, c-format
msgid "Connected via %s and ready for VR launch."
msgstr "Conectado mediante %s y listo para iniciar en RV."

#, c-format
msgid "%s is running, but no active headset responded. Wake or connect your headset, then refresh."
msgstr "%s está activo, pero no respondió ningún visor. Enciende o conecta el visor y vuelve a comprobar."

#, c-format
msgid "Detected over USB. Start %s to connect before launching Elite in VR."
msgstr "Detectado por USB. Inicia %s para conectar antes de lanzar Elite en RV."

#, c-format
msgid "%s is running while %s is set as your active OpenXR runtime. Switch OpenXR or start %s."
msgstr "%s está en ejecución mientras %s es tu entorno OpenXR activo. Cambia OpenXR o inicia %s."

#, c-format
msgid "%s is your active OpenXR runtime, but is not running yet. Start it or connect your headset."
msgstr "%s es tu entorno OpenXR activo, pero aún no está iniciado. Ábrelo o conecta tu visor."

msgid "Active OpenXR runtime file is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it."
msgstr "Falta el archivo del entorno OpenXR activo. Abre SteamVR, Meta Horizon Link, Virtual Desktop o Pimax Play para restaurarlo."

msgid "No active OpenXR runtime is registered. Start SteamVR, Meta Horizon Link, Virtual Desktop, Pimax Play, or WiVRn to enable VR."
msgstr "No hay ningún entorno OpenXR activo registrado. Inicia SteamVR, Meta Horizon Link, Virtual Desktop, Pimax Play o WiVRn para activar la RV."

#, c-format
msgid "%s was found on Linux, but no Windows OpenXR runtime is registered in this Wine/Proton prefix."
msgstr "Se encontró %s en Linux, pero no hay ningún entorno OpenXR de Windows registrado en este prefijo de Wine/Proton."

#, c-format
msgid "The active OpenXR runtime could not be queried. Restart %s and refresh."
msgstr "No se pudo consultar el entorno OpenXR activo. Reinicia %s y vuelve a comprobar."

msgid "Detected over USB, but no active OpenXR runtime is registered yet."
msgstr "Detectado por USB, pero aún no hay un entorno OpenXR activo registrado."

msgid "OpenComposite is installed as Elite's openvr_api.dll, so ED-UP's VR bridge is not active."
msgstr "OpenComposite está instalado como openvr_api.dll de Elite, por lo que el puente de RV de ED-UP no está activo."

msgid "edup_openxr.ini could not be read by ED-UP. Repair ED-UP or fix the file, then refresh."
msgstr "ED-UP no pudo leer edup_openxr.ini. Repara ED-UP o corrige el archivo y vuelve a comprobar."

msgid "Active OpenXR runtime library is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it."
msgstr "Falta la biblioteca del entorno OpenXR activo. Abre SteamVR, Meta Horizon Link, Virtual Desktop o Pimax Play para restaurarla."

msgid "No active OpenXR runtime was found. Elite may fail to start in VR.\n\nLaunch in VR anyway?"
msgstr "No se encontró ningún entorno OpenXR activo. Elite puede fallar al iniciar en RV.\n\n¿Iniciar en RV de todos modos?"

msgid "Your active OpenXR runtime file is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it.\n\nLaunch in VR anyway?"
msgstr "Falta el archivo de tu entorno OpenXR activo. Abre SteamVR, Meta Horizon Link, Virtual Desktop o Pimax Play para restaurarlo.\n\n¿Iniciar en RV de todos modos?"

msgid "Your active OpenXR runtime library is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it.\n\nLaunch in VR anyway?"
msgstr "Falta la biblioteca de tu entorno OpenXR activo. Abre SteamVR, Meta Horizon Link, Virtual Desktop o Pimax Play para restaurarla.\n\n¿Iniciar en RV de todos modos?"

msgid "edup_openxr.ini could not be read by ED-UP, so Elite will not start in VR. Repair ED-UP or fix the file.\n\nLaunch in VR anyway?"
msgstr "ED-UP no pudo leer edup_openxr.ini, por lo que Elite no iniciará en RV. Repara ED-UP o corrige el archivo.\n\n¿Iniciar en RV de todos modos?"

#, c-format
msgid "%s did not respond in time. Live checks are paused until you restart the launcher."
msgstr "%s no respondió a tiempo. Las comprobaciones en vivo están pausadas hasta reiniciar el launcher."

msgid "Theme: follow Windows (switch to light)"
msgstr "Tema: seguir a Windows (cambiar a claro)"

msgid "Theme: light (switch to dark)"
msgstr "Tema: claro (cambiar a oscuro)"

msgid "Theme: dark (follow Windows)"
msgstr "Tema: oscuro (seguir a Windows)"
