msgstr "Подключён и готов к запуску в VR."

#, c-format
msgid "Connected via %s and ready for VR launch."
msgstr "Подключён через %s и готов к запуску в VR."

#, c-format
msgid "%s is running, but no active headset responded. Wake or connect your headset, then refresh."
msgstr "%s запущена, но активный шлем не ответил. Включите или подключите шлем и нажмите Обновить."

#, c-format
msgid "Detected over USB. Start %s to connect before launching Elite in VR."
msgstr "Обнаружен по USB. Запустите %s перед запуском Elite в VR."

#, c-format
msgid "%s is running while %s is set as your active OpenXR runtime. Switch OpenXR or start %s."
msgstr "Запущена %s, но активной средой OpenXR выбрана %s. Переключите OpenXR или запустите %s."

#, c-format
msgid "%s is your active OpenXR runtime, but is not running yet. Start it or connect your headset."
msgstr "%s выбрана активной средой OpenXR, но ещё не запущена. Запустите её или подключите шлем."

msgid "Active OpenXR runtime file is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it."
msgstr "Файл активной среды OpenXR отсутствует. Откройте SteamVR, Meta Horizon Link, Virtual Desktop или Pimax Play."

msgid "No active OpenXR runtime is registered. Start SteamVR, Meta Horizon Link, Virtual Desktop, Pimax Play, or WiVRn to enable VR."
msgstr "Активная среда OpenXR не зарегистрирована. Запустите SteamVR, Meta Horizon Link, Virtual Desktop, Pimax Play или WiVRn."

#, c-format
msgid "%s was found on Linux, but no Windows OpenXR runtime is registered in this Wine/Proton prefix."
msgstr "%s найдена в Linux, но в этом префиксе Wine/Proton не зарегистрирована среда OpenXR для Windows."

#, c-format
msgid "The active OpenXR runtime could not be queried. Restart %s and refresh."
msgstr "Не удалось опросить активную среду OpenXR. Перезапустите %s и нажмите Обновить."

msgid "Detected over USB, but no active OpenXR runtime is registered yet."
msgstr "Обнаружен по USB, но активная среда OpenXR ещё не зарегистрирована."

msgid "OpenComposite is installed as Elite's openvr_api.dll, so ED-UP's VR bridge is not active."
msgstr "OpenComposite установлен как openvr_api.dll Elite, поэтому VR-мост ED-UP не активен."

msgid "edup_openxr.ini could not be read by ED-UP. Repair ED-UP or fix the file, then refresh."
msgstr "ED-UP не смог прочитать edup_openxr.ini. Восстановите ED-UP или исправьте файл и обновите."

msgid "Active OpenXR runtime library is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it."
msgstr "Библиотека активной среды OpenXR отсутствует. Откройте SteamVR, Meta Horizon Link, Virtual Desktop или Pimax Play."

msgid "No active OpenXR runtime was found. Elite may fail to start in VR.\n\nLaunch in VR anyway?"
msgstr "Активная среда OpenXR не найдена. Elite может не запуститься в VR.\n\nВсё равно запустить в VR?"

msgid "Your active OpenXR runtime file is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it.\n\nLaunch in VR anyway?"
msgstr "Файл активной среды OpenXR отсутствует. Откройте SteamVR, Meta Horizon Link, Virtual Desktop или Pimax Play.\n\nВсё равно запустить в VR?"

msgid "Your active OpenXR runtime library is missing. Open SteamVR, Meta Horizon Link, Virtual Desktop, or Pimax Play to restore it.\n\nLaunch in VR anyway?"
msgstr "Библиотека активной среды OpenXR отсутствует. Откройте SteamVR, Meta Horizon Link, Virtual Desktop или Pimax Play.\n\nВсё равно запустить в VR?"

msgid "edup_openxr.ini could not be read by ED-UP, so Elite will not start in VR. Repair ED-UP or fix the file.\n\nLaunch in VR anyway?"
msgstr "ED-UP не смог прочитать edup_openxr.ini, поэтому Elite не запустится в VR. Восстановите ED-UP или исправьте файл.\n\nВсё равно запустить в VR?"

#, c-format
msgid "%s did not respond in time. Live checks are paused until you restart the launcher."
msgstr "%s не ответила вовремя. Проверки в реальном времени приостановлены до перезапуска лаунчера."

msgid "Theme: follow Windows (switch to light)"
msgstr "Тема: как в Windows (переключить на светлую)"

msgid "Theme: light (switch to dark)"
msgstr "Тема: светлая (переключить на тёмную)"

msgid "Theme: dark (follow Windows)"
msgstr "Тема: тёмная (как в Windows)"
