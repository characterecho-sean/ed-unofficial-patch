msgid "Inspecting the active OpenXR runtime, running VR services, and connected hardware."
msgstr "Проверка активной среды OpenXR, запущенных служб VR и подключённого оборудования."

msgid "No headset detected"
msgstr "Шлем не обнаружен"

msgid "No VR runtime found"
msgstr "Среда VR не найдена"

